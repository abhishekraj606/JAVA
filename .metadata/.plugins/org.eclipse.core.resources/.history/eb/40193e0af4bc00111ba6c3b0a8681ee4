package com.kodewala.arrays1;

public class ArrayDemo
{

	public static void main(String[] args)
	{
		int balances[] = new int[5];
		
		balances[0] = 1500;
		balances[1] = 2500;
		balances[2] = 1800;
		balances[3] = 5000;
		balances[4] = 1200;
		
		System.out.println(balances[0]);
		System.out.println(balances[1]);
		System.out.println(balances[2]);
		System.out.println(balances[3]);
		System.out.println(balances[4]);
		
		for (int index = 0; index < 5; index++)
		{
			System.out.println(balances[index]);
		}

	}

}
