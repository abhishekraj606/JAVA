package com.kodewala.loops1;

public class SBIBank
{

	public static void main(String[] args)
	{
		SBICustomer customers[] = new SBICustomer[5];
		
		customers[0] = new SBICustomer("Rahul", 1500, "9876543210");
		customers[1] = new SBICustomer("Amit", 4500, "9876543211");
		customers[2] = new SBICustomer("Priya", 1800, "9876543212");
		customers[3] = new SBICustomer("Neha", 2500, "9876543213");
		customers[4] = new SBICustomer("Ravi", 1200, "9876543214");
		
		for(int i=0;i<customers.length;i++)
		{
			if(customers[i].balance<2000)
			{
				System.out.println(customers[i].name+" is having balance less than 2000, His balance is: "+customers[i].balance)
			}
		}

	}

}
